# Copy to .env (gitignored) and fill in.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free = synthetic/test data only (Google may use free-tier content, ADR-014). paid = real data OK.
GEMINI_TIER=free

# Who "I" am, so the model knows which side of a conversation is yours.
USER_NAME=Sehaj Preet
USER_EMAIL=sehaj.demo@example.com

# Optional overrides
# LLM_MODEL=gemini-3.8-flash
# DATA_DIR=~/Library/Application Support/ContextAgent
